# SkillMatch REST API — URL rewriting
#
# Routing itself lives in index.php (the front controller). Apache only needs to
# do two things here:
#   1. hand the Authorization header to PHP so Bearer tokens work
#   2. hand every non-file request to index.php
#
# Do NOT re-introduce per-path RewriteRules. mod_dir enters each physical
# sub-directory (api/freelancers/, api/jobs/, ...) and re-applies this ruleset
# against the new per-directory prefix, which sent requests into an infinite
# redirect loop (AH00124: Request exceeded the limit of 10 internal redirects).
# A single catch-all rule cannot loop.

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Apache does not pass the Authorization header to PHP by default, so
  # $_SERVER['HTTP_AUTHORIZATION'] is empty and every Bearer token is rejected.
  RewriteCond %{HTTP:Authorization} ^(.*)
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

  # Real files (uploads, existing .php entry points) are served untouched.
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # Everything else is an API route.
  RewriteRule ^ index.php [L,QSA]
</IfModule>
